# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code / OMC 작업 흔적 (저장소에 올리지 않음)
.claude/
.omc/
.playwright-mcp/

# 일회성 적용 스크립트 (저장소에 올리지 않음)
apply-*.mjs

# Supabase 마이그레이션 — 개인 운영, git에 올리지 않음
supabase/migrations/

# Playwright 산출물
/playwright-report/
/test-results/

# 디자인 참고용 standalone HTML (번들 포함 대용량) — 로컬 보관, repo 제외
docs/design/*.html

