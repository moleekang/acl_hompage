# ============================================================
# AICONLAB Homepage — Local Environment Template
# Copy to .env.local and fill in actual values.
# DO NOT COMMIT .env.local (already in .gitignore).
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App ──────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /admin · /insights · /llm-wiki 가드 우회 (디자인 미리보기 전용, 서버 전용 env)
# 명시적으로 '1'을 설정한 경우에만 인증 우회. 미설정/빈 값/기타 모두 가드 ON.
# 운영에는 절대 설정하지 말 것.
# ADMIN_PREVIEW_MODE=1

# ── E2E (Playwright) ─────────────────────────────────────────
# Playwright admin 자동 로그인용. .env.local에만 실제 값 적고 절대 commit하지 말 것.
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=<your-admin-password>

# ── Aicon Log (활동 로그 적재) ────────────────────────────────
# AICON_LOG_ENABLED: 마스터 ON/OFF 스위치.
#   true  → 운영/스테이징 (적재 ON)
#   false → 폐쇄망/CI/오프라인 dev (네트워크 호출 0건)
# API_KEY는 서버 전용 — NEXT_PUBLIC_ prefix로 절대 노출하지 말 것.
# 클라이언트 이벤트는 /api/aicon-log 프록시가 서버에서 키를 부착해 릴레이한다.
AICON_LOG_ENABLED=true
AICON_LOG_BASE_URL=https://<aicon-log-server>
AICON_LOG_API_KEY=ak_live_<your-key>
# 클라이언트(브라우저) 측 트래커 ON/OFF — false면 프록시 호출 자체를 생략
NEXT_PUBLIC_AICON_LOG_ENABLED=true
